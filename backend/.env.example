DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
POSTGRES_DB=ap_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional local-only demo seed credentials (never use for production)
DEMO_ADMIN_PASSWORD=
DEMO_APPROVER_PASSWORD=
AP_ALLOW_DEMO_SEED=false

# Optional IMAP invoice mailbox ingestion
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
EMAIL_INGEST_USER=admin

# Optional SMTP delivery for approval/reminder notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Optional local semantic invoice extraction using an Ollama-compatible runtime
# Leave LOCAL_LLM_MODEL empty to use deterministic OCR/rule-based suggestions only.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=

# Optional ERP and bank connector endpoints; never use demo credentials
ERP_API_URL=
ERP_API_TOKEN=
BANK_API_URL=
BANK_API_TOKEN=

# Optional external GST verification service
GST_VALIDATION_URL=
GST_VALIDATION_TOKEN=

# Optional PO matching tolerances (amounts in the configured currency)
PO_MATCH_LINE_TOLERANCE=0.01
PO_MATCH_AMOUNT_TOLERANCE=0.01
PO_MATCH_QUANTITY_TOLERANCE_PERCENT=0
PO_MATCH_PRICE_TOLERANCE_PERCENT=1

# Production HTTPS settings; set DJANGO_DEBUG=false and a unique DJANGO_SECRET_KEY.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_PROXY_SSL_HEADER=false
